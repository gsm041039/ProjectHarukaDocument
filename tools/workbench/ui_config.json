    {
      "cap": 2,
      "label": "最多 2 個",
      "why": "複雜跨 Act／世界系統研究（預設）"
    },
    {
      "cap": 4,
      "label": "最多 4 個",
      "why": "明確大型整體審查（要你批先開）"
